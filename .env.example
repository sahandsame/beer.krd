# ── Database ─────────────────────────────────────────────
# Local dev: `pnpm db:dev` starts an embedded Postgres on port 5433
DATABASE_URL=postgres://beer:beer@localhost:5433/beer

# ── Auth (admin.beer.krd) ────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3100

# ── Apps ─────────────────────────────────────────────────
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3100
# Shared secret the admin uses to tell the public site to refresh its cache
REVALIDATE_SECRET=change-me-too

# ── Media ────────────────────────────────────────────────
# Directory where uploads are written (shared Docker volume in production)
UPLOADS_DIR=./.data/uploads
# Public base URL that serves uploads (the web app's /media route)
MEDIA_BASE_URL=http://localhost:3000/media

# ── Notifications ────────────────────────────────────────
# Optional fallback; can also be set in Admin → Settings. Never commit the real URL.
DISCORD_WEBHOOK_URL=

# ── Seed (first owner account) ───────────────────────────
SEED_OWNER_EMAIL=owner@beer.krd
SEED_OWNER_PASSWORD=change-me-on-first-login
SEED_OWNER_NAME=Beer Owner
