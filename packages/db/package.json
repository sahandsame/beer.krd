{
  "name": "@beer/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./queries": "./src/queries/public.ts",
    "./seed-data": "./src/seed-data.ts"
  },
  "scripts": {
    "db:dev": "node --env-file-if-exists=../../.env --import tsx scripts/dev-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@beer/i18n": "workspace:*",
    "@beer/validators": "workspace:*",
    "better-auth": "1.7.21",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@beer/config": "workspace:*",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
