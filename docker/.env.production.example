# Copy to .env at the repo root on the VPS. Never commit the filled-in file.

# Images (the deploy workflow pushes these; OWNER = your GitHub user/org, lowercase)
IMAGE_PREFIX=ghcr.io/owner/beer-krd
TAG=latest

# Let's Encrypt contact for HTTPS certificates
ACME_EMAIL=

# Postgres
POSTGRES_USER=beer
POSTGRES_PASSWORD=
POSTGRES_DB=beer
# Same password as above:
DATABASE_URL=postgres://beer:PASSWORD@postgres:5432/beer

# Public URLs
WEB_URL=https://beer.krd
ADMIN_URL=https://admin.beer.krd
BETTER_AUTH_URL=https://admin.beer.krd
MEDIA_BASE_URL=https://beer.krd/media

# Secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
REVALIDATE_SECRET=

# Optional: Discord webhook (can also be set in Admin → Settings)
DISCORD_WEBHOOK_URL=

# First owner account (only used while the database has no users)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=

# Optional self-hosted Umami analytics
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
